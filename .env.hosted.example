# Copiar a .env.hosted en el servidor. No commitear el archivo con valores reales.
# El hostname debe pertenecer a una zona de Cloudflare con un Tunnel publicado.
CRM_PUBLIC_HOST=crm.example.com

# Usar valores largos y distintos entre sí.
RABBITMQ_USER=crm
RABBITMQ_PASSWORD=replace-me
KEYCLOAK_DB_PASSWORD=replace-me
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=replace-me
CRM_INITIAL_ADMIN_PASSWORD=replace-me

# Se usa sólo con `docker compose --profile tunnel up`.
CLOUDFLARE_TUNNEL_TOKEN=
