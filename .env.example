# Variables de infraestructura local (V2-FND-003). Sin secretos reales: todo lo que
# aparece acá es de desarrollo, corre en localhost y se descarta al bajar el Compose
# (docker-compose.yml no declara volúmenes persistentes a propósito).
#
# Copiar a `.env` para uso local con docker compose / dotnet test si hace falta
# sobreescribir un valor; los defaults ya funcionan contra `docker compose up`.

# --- MongoDB ---
# Un solo contenedor (mongo:7.0.43) levantado como replica set de un nodo (rs0),
# requerido por el outbox transaccional decidido en V2-FND-002. El miembro del
# replica set se anuncia internamente como "mongo:27017" (DNS de Compose), así que
# un cliente que corre en el host (dotnet test local o en el runner de CI) necesita
# `directConnection=true` para no intentar resolver ese hostname. Las dos variables
# apuntan al MISMO contenedor/puerto, tal como pide V2-FND-003.
MONGO_CONNECTION_STRING=mongodb://localhost:27017/?directConnection=true
MONGO_REPLICA_SET_CONNECTION_STRING=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true

# Si en una wave futura un servicio se conecta DESDE DENTRO de la red de Compose
# (ej. un contenedor de servicio .NET agregado al mismo docker-compose.yml), no hace
# falta directConnection=true: "mongo:27017" resuelve ahí y coincide con el host
# anunciado por rs.initiate. Alcanza con mongodb://mongo:27017/?replicaSet=rs0.

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
# UI de administración: http://localhost:15672 (guest/guest, solo dev)

# --- Keycloak ---
# Realm importado como código desde infra/keycloak/realm-export/crm-dev-realm.json.
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=crm-dev
KEYCLOAK_CLIENT_ID=operations-bff
KEYCLOAK_DEV_USERNAME=dev.vendedor
KEYCLOAK_DEV_PASSWORD=dev.vendedor
# Credenciales de arranque del admin de Keycloak (KC_BOOTSTRAP_ADMIN_*). Ficticias,
# solo para levantar la consola de administración en desarrollo local.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin-dev-only

# El client "operations-bff" es público, con Standard Flow (login real futuro del BFF
# vía cookie + PKCE) y Direct Access Grants habilitado. Direct Access Grants (password
# grant) es SOLO para KeycloakDevRealmTests y pruebas manuales de desarrollo: el login
# real de las webs va a seguir yendo por el BFF con cookie de sesión (AUTH-001,
# V2-FND-002), nunca por password grant directo desde un front.
